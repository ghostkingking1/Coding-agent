# 复制为 .env 后填写云端或已授权服务的配置；不要把实际 .env 提交到版本库。
CODING_AGENT_MODEL_PROVIDER=openai-compatible
CODING_AGENT_MODEL_BASE_URL=https://api.openai.com/v1
CODING_AGENT_MODEL=your-tool-capable-cloud-model

# 必填：替换为云端服务提供的 API key，仅保存于本机 .env。
CODING_AGENT_MODEL_API_KEY=replace-with-your-api-key

# 可选：必须为正整数。
# CODING_AGENT_MODEL_TIMEOUT_MS=30000
# CODING_AGENT_MODEL_MAX_RESPONSE_BYTES=1048576
