# 复制为 .env 后填写本机或已授权服务的配置；不要把实际 .env 提交到版本库。
CODING_AGENT_MODEL_PROVIDER=openai-compatible
CODING_AGENT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
CODING_AGENT_MODEL=your-tool-capable-local-model

# 本地服务通常不需要 API key；需要时仅填写到本机的 .env。
# CODING_AGENT_MODEL_API_KEY=

# 可选：必须为正整数。
# CODING_AGENT_MODEL_TIMEOUT_MS=30000
# CODING_AGENT_MODEL_MAX_RESPONSE_BYTES=1048576
